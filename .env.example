# Copy this file to a file named .env in this same folder, then fill in your keys.
# The api and the benchmark read that .env file on their own when it is there.
# You can still set the same values as environment variables in your shell instead.
# Leave META_BASE_URL empty unless you are using a local connector proxy.
MODEL_API_KEY=
META_BASE_URL=
PORT=8390
# Second model, optional. Leave blank unless you are comparing providers.
# SECOND_MODEL_PROVIDER can be fireworks, baseten or modal.
# Modal also needs SECOND_MODEL_BASE_URL.
SECOND_MODEL_PROVIDER=
SECOND_MODEL_API_KEY=
SECOND_MODEL_BASE_URL=
SECOND_MODEL_ID=
